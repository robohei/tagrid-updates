<?xml version="1.0" encoding="utf-8"?>
<!--
    Tagrid update feed.

    This file is what every installed copy of Tagrid checks, about once a day,
    to find out whether a newer version exists. Its address is compiled into the
    app (SUFeedURL in Config/Info.plist) and can never be changed for copies
    already in the wild.

    No <item> elements yet: nothing has been released. Sparkle reads this as
    "no update available", which is the correct answer today. Release entries
    are generated by Sparkle's generate_appcast tool, not written by hand.
-->
<rss version="2.0" xmlns:sparkle="http://www.andymatuschak.org/xml-namespaces/sparkle">
    <channel>
        <title>Tagrid</title>
        <link>https://robohei.github.io/tagrid-updates/appcast.xml</link>
        <description>Software updates for Tagrid, a macOS audio tag editor.</description>
        <language>en</language>
    </channel>
</rss>
